# =====================================================================
# CAT 2027 HQ: Environment Configuration Template
# =====================================================================

# Supabase Client Configuration (Frontend)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note on AI Coach Keys:
# AI API Keys (GEMINI_API_KEY or OPENAI_API_KEY) must NEVER be placed in frontend code.
# Instead, add them to your Supabase Edge Function secrets:
# supabase secrets set GEMINI_API_KEY=your-key-here
# or
# supabase secrets set OPENAI_API_KEY=your-key-here
